# Copy to infra/.env.prod and fill in real values before deploying.
# NEVER commit infra/.env.prod itself — it holds real secrets.
# Used by: docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d --build

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=fuel_tracking
POSTGRES_PASSWORD=CHANGE_ME_generate_a_real_password
POSTGRES_DB=fuel_tracking

# ── API ───────────────────────────────────────────────────────────────
# The public origin(s) the web app is served from, comma-separated, no
# wildcard. Only matters for traffic that hits the API directly — normal
# browser use goes through the web container's nginx proxy, same-origin.
CORS_ORIGINS=https://fuel.example.com

# Generate with: openssl rand -hex 48
# Never reuse the value in apps/api/.env — that one is a checked-in
# local-dev convenience value, not a secret.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_real_random_secret

# Optional — defaults shown, uncomment to override.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ── Web ───────────────────────────────────────────────────────────────
# Leave as the default relative path unless the API is genuinely served
# from a different origin than the web app (uncommon — see
# infra/DEPLOYMENT.md).
# VITE_API_BASE_URL=/api/v1

# Host port the web container's nginx listens on (put your real reverse
# proxy / load balancer with a TLS certificate in front of this).
# WEB_PORT=8080
