# Root-level reference only — actual apps read from their own .env files:
#   apps/api/.env.example
#   apps/web/.env.example
# Values below are what infra/docker-compose.yml provisions for local dev
# and are duplicated here so a fresh clone can see everything at a glance.

# Postgres (infra/docker-compose.yml)
POSTGRES_USER=fuel_tracking
POSTGRES_PASSWORD=fuel_tracking
POSTGRES_DB=fuel_tracking
POSTGRES_PORT=5432

# apps/api
DATABASE_URL="postgresql://fuel_tracking:fuel_tracking@localhost:5432/fuel_tracking?schema=public"
CORS_ORIGINS="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_REFRESH_EXPIRES_IN="7d"

# apps/web
VITE_API_BASE_URL="http://localhost:3000/api/v1"
