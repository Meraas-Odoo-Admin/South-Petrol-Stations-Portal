infra/.env.prod

# Playwright (apps/web/e2e)
apps/web/test-results/
apps/web/playwright-report/
apps/web/e2e/.fixtures.json
apps/web/e2e/.fake-camera.y4m

# Dev-only verification screenshots and working notes — not app code, no
# ongoing value once a round is verified and merged.
docs/screenshots/verify/
apps/web/docs/screenshots/
# Claude outputs/ is tracked (private repo), except spreadsheets: they can hold real
# people's names and phone numbers (sabha-stations.csv does).
Claude outputs/*.csv
Claude outputs/*.xlsx
Claude outputs/*.xls

# The client design handoff (design/design_handoff_fuel_control_system/) is
# now tracked: it is the reference archive and holds the vehicle card print
# spec. The canonical design rulebook is apps/web/DESIGN.md.

# Impeccable's repo-root working folder: critique snapshots, hook cache and
# local config. Anchored to the root so apps/web/.impeccable/design.json (the
# design sidecar, which IS committed) is not caught.
/.impeccable/

# Phase 5C: real client data (names + phone numbers) — never committed.
data/private/
apps/web/e2e/.fake-camera-history.y4m
