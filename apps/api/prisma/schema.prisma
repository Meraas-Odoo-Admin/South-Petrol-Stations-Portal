// M1 scope: Auth, RBAC, Users, Companies, Stations.
// M2 scope: Drivers, VehicleOwners, Vehicles.
// M3 scope: FillUpTransaction, ExceptionType, Exception.
// See docs/IMPLEMENTATION_PLAN.md §4 for the full schema this will grow into.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Companies & Stations ─────────────────────────────────────────────

model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  stations  Station[]
  createdAt DateTime  @default(now())
}

model Station {
  id            String  @id @default(cuid())
  internalCode  String  @unique // the ONLY globally unique station identifier — auto-generated on create, like Vehicle.internalCode (VehiclesService.generateInternalCode's pattern)
  stationNumber String // as reported by the company — NOT globally unique
  name          String
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  // station-card-field-spec: municipality/route were free text (or, for
  // route, didn't exist) — both are now Settings-managed lookup tables,
  // same reasoning as Company/SecurityAuthority: real data reuses the same
  // ~15-20 municipality names across dozens of stations, and free text
  // guarantees spelling drift ("الشاطئ" vs "الشاطئي" vs "الشاطي" all
  // appearing for the same place). Left NULLABLE rather than required —
  // the spec's own field table marks this "required", but forcing that at
  // the DTO level would mean every existing station-creation call site
  // (global-setup.ts's e2e fixture, admin-rbac.e2e-spec.ts) needs a real
  // seeded municipality first; treated the same as every other
  // schema-affecting judgment call in this project — nullable/flexible
  // until that's confirmed as a hard requirement, not silently forced.
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  routeId        String?
  route          Route?        @relation(fields: [routeId], references: [id])

  status     StationStatus @default(ACTIVE)
  // Only shown/meaningful in the UI once status !== ACTIVE — e.g. "needs a
  // new electrical connection" or "awaiting fuel-distribution approval,"
  // the free-text detail a fixed status enum can't capture on its own.
  statusNote String?

  // Fixed two-value enum, not Settings-managed — same reasoning as
  // StationStatus itself (see the schema-level note on StationStatus):
  // rule engine / reporting code would need to keep working if someone
  // renamed or deleted a Settings-list entry, so this lives in code, not
  // an admin-editable table. Nullable: not every existing/incomplete
  // station record has this confirmed yet (see the "زاوية مرزق" example in
  // station-card-field-spec — location/status known, ownership not).
  ownershipType StationOwnershipType?

  securityAuthorityId String? // TBD — see docs/OPEN_ITEMS.md #4. Nullable until scope question is answered.
  securityAuthority   SecurityAuthority?        @relation(fields: [securityAuthorityId], references: [id])
  fuelAvailability    StationFuelAvailability[]

  // station-card-field-spec items 11-15: supervisor is the primary
  // contact; operator defaults to "same person" (operatorSameAsSupervisor)
  // rather than duplicating the name/phone into operatorName/operatorPhone
  // — the real data's own recurring "نفس المشرف" case. When true,
  // operatorName/operatorPhone stay null and callers read the supervisor
  // fields instead (StationsService enforces this on create/update, not
  // left to every reader to remember).
  supervisorName           String?
  supervisorPhone          String?
  operatorSameAsSupervisor Boolean @default(false)
  operatorName             String?
  operatorPhone            String?

  userScopes UserStationScope[]
  fillUps    FillUpTransaction[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([companyId, stationNumber]) // the composite key that encodes the lesson learned
}

enum StationOwnershipType {
  GOVERNMENT // حكومية
  PRIVATE // خاصة
}

// station-card-field-spec item 4 / item 5 — Settings-managed, same CRUD
// shape as Company (companies.module.ts): a plain admin-editable list,
// nothing in the rule engine or reporting branches on which municipality a
// station is in.
model Municipality {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  stations  Station[]
  createdAt DateTime  @default(now())
}

// station-card-field-spec item 5 — the client's ownership/haulage route
// (خط الإعداد), e.g. "خط سبها" — optional on a station, Settings-managed
// like Municipality/Company.
model Route {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  stations  Station[]
  createdAt DateTime  @default(now())
}

// Fixed, not Settings-managed — unlike Company/Municipality/Route (pure
// labels, nothing in the code branches on which one a station has), the
// rule engine/reporting/filtering logic checks against these specific
// values by name. A freely-editable Settings list would let someone
// rename or delete ACTIVE and quietly break every place that checks for
// it. See station-card-field-spec's own "why status and ownership-type
// aren't Settings-managed" section.
enum StationStatus {
  ACTIVE
  SUSPENDED_LEGAL // موقوفة قضائيًا
  SUSPENDED_COMMITTEE // موقوفة (لجنة)
  SUSPENDED_OWNER // معلّقة - خاصة
  NOT_YET_SUPPLIED // لم تُزوَّد بعد
  UNVERIFIED // غير مؤكد — from the handwritten list, needs manual review
}

// Fuel availability is TIME-VARYING per the client — never a fixed column on Station.
model StationFuelAvailability {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id])
  fuelType    FuelType
  isAvailable Boolean  @default(true)
  updatedBy   String? // userId
  updatedAt   DateTime @updatedAt

  @@unique([stationId, fuelType])
}

enum FuelType {
  PETROL_95
  DIESEL
  KEROSENE // currently unused per client, but the enum stays open for the future
}

// Placeholder for the لجنة إعادة تنظيم المدن scope question — left unseeded until
// docs/OPEN_ITEMS.md #4 is answered.
model SecurityAuthority {
  id       String    @id @default(cuid())
  name     String    @unique // "مديرية أمن سبها", "الحرس البلدي", "الجمارك", ...
  stations Station[]
}

// ── RBAC ──────────────────────────────────────────────────────────────

model Role {
  id                        String           @id @default(cuid())
  name                      String           @unique // "station_employee", "station_supervisor", "directorate_admin", "system_admin"
  description               String?
  // Explicit, admin-managed "sees every station" flag. Never inferred from
  // an empty UserStationScope list — a scoped role with zero assigned
  // stations must see NOTHING, not everything. Only directorate-wide roles
  // (directorate_admin, system_admin) get this set to true.
  unrestrictedStationAccess Boolean          @default(false)
  permissions               RolePermission[]
  users                     UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // "fillups:create", "fillups:approve_exception", "reports:view_all_stations"
  description String?
  roles       RolePermission[]
  users       UserPermission[]
}

// Round 12: the client wants a right that is NOT tied to a role — "given to
// certain users they pick, it could be given to certain employees and not
// for other employees" (specifically fillups:record_exception, but built
// generically since the same need will recur). RbacService unions this with
// role-derived permissions rather than replacing them — a direct grant is
// additive on top of whatever the user's roles already provide, never a
// narrower override.
model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  grantedById  String
  grantedBy    User       @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])
  grantedAt    DateTime   @default(now())

  @@id([userId, permissionId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id                           String                 @id @default(cuid())
  username                     String                 @unique
  passwordHash                 String
  fullName                     String
  phone                        String?
  isActive                     Boolean                @default(true)
  mustChangePassword           Boolean                @default(false)
  failedLoginAttempts          Int                    @default(0)
  lockedUntil                  DateTime?
  roles                        UserRole[]
  directPermissions            UserPermission[]
  permissionsGranted           UserPermission[]       @relation("UserPermissionGrantedBy")
  stationScope                 UserStationScope[] // the stations this user is confined to, UNLESS one of their roles has unrestrictedStationAccess: true — an empty list here means access to NO stations, never "all of them"
  refreshTokens                RefreshToken[]
  recordedFillUps              FillUpTransaction[]    @relation("RecordedBy")
  vehicleChangeRequestsMade    VehicleChangeRequest[] @relation("VehicleChangeRequestedBy")
  vehicleChangeRequestsDecided VehicleChangeRequest[] @relation("VehicleChangeDecidedBy")
  standingExceptionsGranted    StandingException[]    @relation("StandingExceptionGrantedBy")
  standingExceptionsRevoked    StandingException[]    @relation("StandingExceptionRevokedBy")
  auditLogs                    AuditLog[]
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// Station-scoped access — a station employee is restricted to their station(s) at the QUERY level, not just the UI.
model UserStationScope {
  userId    String
  stationId String
  user      User    @relation(fields: [userId], references: [id])
  station   Station @relation(fields: [stationId], references: [id])

  @@id([userId, stationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String // never store the raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Tunable business rules — the whole point of §3 ───────────────────

model SystemSetting {
  key         String   @id // "fillup.max_per_week", "fillup.min_gap_days", "fillup.week_start_day", "fillup.max_per_week_per_driver", "fillup.min_gap_days_per_driver", "fillup.week_window_mode"
  value       String // stored as string, parsed by the consuming service
  description String?
  updatedAt   DateTime @updatedAt
}

// ── Drivers, Owners, Vehicles ────────────────────────────────────────

enum IdentityType {
  NATIONAL_ID
  ADMINISTRATIVE_ID // بديل معتمد لدى الطوارق وقبائل أخرى — equally valid per client confirmation
  // Round 11 item 1: a one-time fallback when the owner's real ID isn't
  // available on the spot — deliberately NOT equal standing to the other
  // two (see VehicleOwner.identityType's own comment and
  // FillUpsService.create's provisional-owner gate). No standard Libyan
  // driver's-license number format was found during research (only plate
  // formats and application-process pages turned up) — validated
  // permissively for now (DRIVERS_LICENSE_REGEX), see docs/OPEN_ITEMS.md.
  DRIVERS_LICENSE
}

// Round 6: no longer required on a fill-up, and has no active create/edit UI
// (see docs/DESIGN_owner_based_fillups.md) — kept only so historical
// FillUpTransaction/DriverVehicle rows recorded before this change keep
// their driver attribution. Not written to going forward.
model Driver {
  id             String              @id @default(cuid())
  identityType   IdentityType
  identityNumber String // immutable together with identityType after creation, like User.username
  fullName       String
  phone          String? // TBD — see docs/OPEN_ITEMS.md #7. Nullable until confirmed.
  vehicles       DriverVehicle[]
  fillUps        FillUpTransaction[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([identityType, identityNumber])
}

// Round 11 item 1: owner identity is mandatory on a vehicle going forward
// (see Vehicle.ownerId), but a real national/administrative ID isn't
// always available on the spot when a vehicle is first registered — a
// DRIVERS_LICENSE identityType is a deliberately PROVISIONAL stand-in,
// good for exactly the vehicle's first fill-up (FillUpsService.create
// hard-blocks any later one, no exception route — the client's own
// framing was "only the first fill is available," not a flaggable rule).
// Provisional-ness is derived directly from identityType ===
// 'DRIVERS_LICENSE' rather than a separate status field — nothing else
// needs to vary independently of it yet; add a real status field instead
// if that ever changes.
model VehicleOwner {
  id                 String              @id @default(cuid())
  identityType       IdentityType
  identityNumber     String // immutable together with identityType after creation, like Driver.identityNumber/User.username
  fullName           String
  phone              String?
  address            String?
  vehicles           Vehicle[]
  standingExceptions StandingException[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([identityType, identityNumber])
}

enum VehicleUsageType {
  GOVERNMENT
  PRIVATE
  COMMERCIAL
}

// Round 12: "نوع المركبة" becomes a Settings-managed lookup, same shape as
// Municipality/Route/ExceptionType — admin/system_admin add categories
// (سيارة خاصة, نقل ثقيل, ...) without a deploy. Distinct from
// VehicleUsageType (GOVERNMENT/PRIVATE/COMMERCIAL, "نوع الاستخدام") — the
// client only asked to change this one, not the usage-type enum. Confirmed
// via the rule engine (no reference to either field anywhere in
// fillups/rule-engine) that converting this to a lookup table is safe.
model VehicleType {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
}

model Vehicle {
  id                  String                  @id @default(cuid())
  internalCode        String                  @unique // fixed forever, even if the plate changes
  currentPlate        String                  @unique
  chassisNumber       String?                 @unique
  // رقم كتيب السيارة — added for the anti-fraud chassis/booklet linkage
  // (docs/IMPLEMENTATION_PLAN.md phase note: chassis-booklet-linkage
  // proposal). Nullable: not every vehicle has one recorded yet.
  registrationBooklet String?                 @unique
  vehicleTypeId       String?
  vehicleType         VehicleType?            @relation(fields: [vehicleTypeId], references: [id])
  model               String?
  color               String?
  manufactureYear     Int?
  usageType           VehicleUsageType?
  // Round 11 item 1: the client confirmed owner information should be
  // mandatory going forward — enforced at CreateVehicleDto (application
  // level: ownerId is now required on create), NOT here. Left nullable in
  // the DATABASE deliberately: real existing vehicles have no owner at
  // all today (this column being nullable is exactly how that's possible
  // right now), and forcing it NOT NULL would need a migration/backfill
  // decision for those rows that hasn't been made — see docs/OPEN_ITEMS.md.
  // Don't silently pick a backfill strategy by flipping this to required.
  ownerId             String?
  owner               VehicleOwner?           @relation(fields: [ownerId], references: [id])
  plateHistory        VehiclePlateHistory[]
  chassisHistory      VehicleChassisHistory[]
  bookletHistory      VehicleBookletHistory[]
  changeRequests      VehicleChangeRequest[]
  drivers             DriverVehicle[]
  fillUps             FillUpTransaction[]
  standingExceptions  StandingException[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

// Plates change (sale, re-registration, damage) — never lose fill-up history
// when that happens. Rows are closed (validTo set), never deleted/overwritten.
model VehiclePlateHistory {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  plate     String
  validFrom DateTime  @default(now())
  validTo   DateTime?

  @@index([vehicleId])
}

// Same pattern as VehiclePlateHistory, for chassisNumber. Only ever written
// by VehiclesService.applyApprovedChange (via a VehicleChangeRequest
// approval) once a value already exists — a first-time null -> value set
// doesn't go through the request/approval flow at all, so it doesn't get a
// history row either (nothing to preserve yet).
model VehicleChassisHistory {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  chassisNumber String
  validFrom     DateTime  @default(now())
  validTo       DateTime?

  @@index([vehicleId])
}

// Same pattern, for registrationBooklet.
model VehicleBookletHistory {
  id                  String    @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id])
  registrationBooklet String
  validFrom           DateTime  @default(now())
  validTo             DateTime?

  @@index([vehicleId])
}

enum VehicleChangeType {
  CHASSIS_CHANGE
  BOOKLET_CHANGE
  // Round 12: the client wants a vehicle-edit approval gate that follows
  // rule-eligibility impact, not an arbitrary field list — "things that
  // don't affect their fill up rule status" save immediately (model, color,
  // manufactureYear, vehicleTypeId — see VehiclesService.update), "things
  // that need approval are the ones that affect their fill up status" go
  // through this same request/approval flow instead. The rule engine keys
  // strictly off vehicleId + ownerId (see FillUpRuleEngine), so OWNER_CHANGE
  // is the clear case; USAGE_TYPE_CHANGE is included pre-emptively because a
  // per-usage-type liter cap SystemSetting already exists even though it
  // isn't wired into the engine yet (see SettingsAdminPage) — treating it as
  // rule-affecting now avoids a second migration once that wiring lands.
  OWNER_CHANGE
  // Deprecated (round 14): the client asked that "نوع المركبة" and "نوع
  // الاستخدام" not both be collected — one is enough, and it should be the
  // Settings-managed one (VehicleType/vehicleTypeId). usageType stays in
  // the schema for historical rows already carrying a value, but is no
  // longer collected or editable anywhere in the UI — VEHICLE_TYPE_CHANGE
  // below is what replaces this for the one type field that remains.
  USAGE_TYPE_CHANGE
  // Round 14: the client wants EVERY field that could affect a vehicle's
  // fill-up rule status to require approval, requestable by ordinary
  // station employees (not just supervisor-tier) and approved by
  // supervisor/directorate-admin/system-admin — explicitly including the
  // plate number, previously changed directly with no approval at all via
  // POST /vehicles/:id/plate-change (still exists, but now restricted to
  // vehicles:approve_change — see VehiclesController). PLATE_CHANGE reuses
  // the existing VehiclePlateHistory table the same way CHASSIS_CHANGE/
  // BOOKLET_CHANGE reuse their own history tables. VEHICLE_TYPE_CHANGE is
  // the client-requested single "نوع المركبة" field's own change type.
  PLATE_CHANGE
  VEHICLE_TYPE_CHANGE
}

enum VehicleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Anti-fraud gate for displacing an ALREADY-SET chassisNumber/
// registrationBooklet — the requested value never takes effect on creation;
// only VehiclesService.decideChange(..., 'approve') writes it to Vehicle,
// inside the same transaction as the history row and this row's own
// status update. A first-time null -> value set bypasses this table
// entirely (see VehiclesService.setOrRequestChange) — there's no
// established identity to displace yet, so nothing to gate.
model VehicleChangeRequest {
  id              String                     @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle                    @relation(fields: [vehicleId], references: [id])
  changeType      VehicleChangeType
  currentValue    String // snapshot at request time, for audit context
  requestedValue  String
  reason          String
  proofReference  String // mandatory for both change types — not the fill-up ExceptionType's optional-per-category toggle
  status          VehicleChangeRequestStatus @default(PENDING)
  requestedById   String
  requestedBy     User                       @relation("VehicleChangeRequestedBy", fields: [requestedById], references: [id])
  decidedById     String?
  decidedBy       User?                      @relation("VehicleChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  rejectionReason String? // mandatory (enforced at the DTO level) when status is set to REJECTED; unset otherwise

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model DriverVehicle {
  driverId  String
  vehicleId String
  isPrimary Boolean @default(false)
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([driverId, vehicleId])
}

// ── Fill-ups & Exceptions ────────────────────────────────────────────

model FillUpTransaction {
  id                  String             @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id])
  // Nullable since round 6: fill-ups no longer require driver identity (see
  // docs/DESIGN_owner_based_fillups.md) — rule evaluation and standing
  // exceptions are scoped to the vehicle's owner instead. Kept (not
  // dropped) so historical fill-ups recorded before this change keep their
  // driver attribution.
  driverId            String?
  driver              Driver?            @relation(fields: [driverId], references: [id])
  stationId           String
  station             Station            @relation(fields: [stationId], references: [id])
  fuelType            FuelType
  quantityLiters      Decimal
  occurredAt          DateTime           @default(now())
  recordedById        String
  recordedBy          User               @relation("RecordedBy", fields: [recordedById], references: [id])
  isException         Boolean            @default(false)
  exception           Exception?
  // Set when a rule that would have blocked this fill-up was instead
  // auto-allowed by an active StandingException — distinct from the
  // one-time isException/Exception flow (which requires a fresh
  // submission + approval every time). Never set together with
  // isException: a fill-up is either flagged for one-time review or
  // silently covered by a standing grant, not both.
  standingExceptionId String?
  standingException   StandingException? @relation(fields: [standingExceptionId], references: [id])
  // Which specific rule the standing exception covered for THIS fill-up —
  // a grant can cover several rules, but a given fill-up trips at most one
  // (first-failure-wins, same as the rejection path).
  coveredRule         String?
  // Client retry key for POST /fillups — a flaky station connection retrying
  // the same submission must resolve to the SAME row, never a duplicate.
  idempotencyKey      String             @unique
  createdAt           DateTime           @default(now())

  @@index([vehicleId, occurredAt]) // the rule engine's hottest query path
  @@index([driverId, occurredAt])
  @@index([stationId, occurredAt])
}

// Interim design, NOT from the original client questionnaire — flagged to
// the client for confirmation (see docs/OPEN_ITEMS.md). A supervisor/admin
// grants an ongoing exemption from one or more specific rule codes to a
// vehicle owner, a vehicle, or both, instead of the requester needing a
// fresh one-time Exception every single time. Fully audited (grant +
// revoke), visible on the owner/vehicle's own profile, never a blanket
// "exempt from everything" — `rules` lists exactly which RuleFailureReason
// codes (plus the new LITERS_PER_PERSON_CAP_REACHED) this grant covers.
// Round 6: re-scoped from driverId to ownerId — see
// docs/DESIGN_owner_based_fillups.md.
model StandingException {
  id        String        @id @default(cuid())
  ownerId   String?
  owner     VehicleOwner? @relation(fields: [ownerId], references: [id])
  vehicleId String?
  vehicle   Vehicle?      @relation(fields: [vehicleId], references: [id])
  rules     String[] // RuleFailureReason codes this grant covers

  reason      String
  grantedById String
  grantedBy   User      @relation("StandingExceptionGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime? // null = indefinite, active until revoked

  revokedById String?
  revokedBy   User?     @relation("StandingExceptionRevokedBy", fields: [revokedById], references: [id])
  revokedAt   DateTime?

  coveredFillUps FillUpTransaction[]

  @@index([ownerId])
  @@index([vehicleId])
}

// Lookup table, not an enum — the client already surfaced two new exception
// categories after the first questionnaire round. New categories must never
// require a code change.
model ExceptionType {
  id            String      @id @default(cuid())
  key           String      @unique // "medical_chronic", "transit_traveler", "government", "emergency"
  name          String
  requiresProof Boolean     @default(true)
  isActive      Boolean     @default(true)
  exceptions    Exception[]
}

model Exception {
  id                  String            @id @default(cuid())
  fillUpTransactionId String            @unique
  fillUpTransaction   FillUpTransaction @relation(fields: [fillUpTransactionId], references: [id])
  exceptionTypeId     String
  exceptionType       ExceptionType     @relation(fields: [exceptionTypeId], references: [id])
  reason              String
  // Nullable: set only on approval, not at request time — a requested
  // exception has no approver yet (see POST /fillups/:id/exceptions/approve).
  approvedById        String?
  proofReference      String?
  validUntil          DateTime? // null = one-off; set = recurring exception with an expiry
  createdAt           DateTime          @default(now())

  // Diagnostic snapshot of what the rule engine WOULD have rejected this
  // fill-up for, captured server-side at submission time (the engine is
  // run in diagnostic-only mode — its result is never trusted from the
  // client) — so the approver sees why this was flagged instead of a bare
  // "submitted as exception" with no context. Null only for rows created
  // before this field existed.
  triggerReason String? // a RuleFailureReason value, e.g. "DRIVER_GAP_TOO_SHORT"
  triggerDetail Json? // { vehicleInternalCode, vehicleCurrentPlate, occurredAt } of the specific prior fill-up that triggered it
}

// ── Audit ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "APPROVE_EXCEPTION" ...
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
