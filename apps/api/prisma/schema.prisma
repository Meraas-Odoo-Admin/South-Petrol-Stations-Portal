// M1 scope: Auth, RBAC, Users, Companies, Stations.
// M2 scope: Drivers, VehicleOwners, Vehicles.
// M3 scope: FillUpTransaction, ExceptionType, Exception.
// See docs/IMPLEMENTATION_PLAN.md §4 for the full schema this will grow into.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Companies & Stations ─────────────────────────────────────────────

model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  stations  Station[]
  createdAt DateTime  @default(now())
}

model Station {
  id            String  @id @default(cuid())
  internalCode  String  @unique // the ONLY globally unique station identifier — auto-generated on create, like Vehicle.internalCode (VehiclesService.generateInternalCode's pattern)
  stationNumber String // as reported by the company — NOT globally unique
  name          String
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  // station-card-field-spec: municipality/route were free text (or, for
  // route, didn't exist) — both are now Settings-managed lookup tables,
  // same reasoning as Company/SecurityAuthority: real data reuses the same
  // ~15-20 municipality names across dozens of stations, and free text
  // guarantees spelling drift ("الشاطئ" vs "الشاطئي" vs "الشاطي" all
  // appearing for the same place). Left NULLABLE rather than required —
  // the spec's own field table marks this "required", but forcing that at
  // the DTO level would mean every existing station-creation call site
  // (global-setup.ts's e2e fixture, admin-rbac.e2e-spec.ts) needs a real
  // seeded municipality first; treated the same as every other
  // schema-affecting judgment call in this project — nullable/flexible
  // until that's confirmed as a hard requirement, not silently forced.
  // Phase 5C: required (migration 20261013100100_p5c_required_municipality) now
  // that every station sits in a municipality.
  municipalityId String
  municipality   Municipality  @relation(fields: [municipalityId], references: [id])
  routeId        String?
  route          Route?        @relation(fields: [routeId], references: [id])

  status     StationStatus @default(ACTIVE)
  // Only shown/meaningful in the UI once status !== ACTIVE — e.g. "needs a
  // new electrical connection" or "awaiting fuel-distribution approval,"
  // the free-text detail a fixed status enum can't capture on its own.
  statusNote String?

  // Fixed two-value enum, not Settings-managed — same reasoning as
  // StationStatus itself (see the schema-level note on StationStatus):
  // rule engine / reporting code would need to keep working if someone
  // renamed or deleted a Settings-list entry, so this lives in code, not
  // an admin-editable table. Nullable: not every existing/incomplete
  // station record has this confirmed yet (see the "زاوية مرزق" example in
  // station-card-field-spec — location/status known, ownership not).
  ownershipType StationOwnershipType?

  securityAuthorityId String? // No longer used — since Phase 1 a station's authority is its municipality's (Municipality.securityAuthority).
  securityAuthority   SecurityAuthority?        @relation(fields: [securityAuthorityId], references: [id])
  fuelAvailability    StationFuelAvailability[]

  // station-card-field-spec items 11-15: supervisor is the primary
  // contact; operator defaults to "same person" (operatorSameAsSupervisor)
  // rather than duplicating the name/phone into operatorName/operatorPhone
  // — the real data's own recurring "نفس المشرف" case. When true,
  // operatorName/operatorPhone stay null and callers read the supervisor
  // fields instead (StationsService enforces this on create/update, not
  // left to every reader to remember).
  supervisorName           String?
  supervisorPhone          String?
  operatorSameAsSupervisor Boolean @default(false)
  operatorName             String?
  operatorPhone            String?

  // Phase 5A: "delete" means archive. An archived station disappears from
  // daily screens (no fill-up can be recorded at it) but every fill-up, card
  // and audit row that points at it stays. Restored by clearing both columns.
  // Phase 5A: the area or neighbourhood inside the municipality, used by the
  // municipality manager's station list filter. Free text, optional.
  locality String?

  // Phase 5B: the supervisor's switch «إظهار المخزون للموظفين». When false the
  // API itself refuses to show fuel levels to the station's employees.
  showStockToEmployees Boolean @default(true)

  archivedAt   DateTime?
  archivedById String?

  userScopes       UserStationScope[]
  fillUps          FillUpTransaction[]
  fuelStorages     StationFuelStorage[]
  fuelStockEntries FuelStockEntry[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([companyId, stationNumber]) // the composite key that encodes the lesson learned
}

enum StationOwnershipType {
  GOVERNMENT // حكومية
  PRIVATE // خاصة
}

// station-card-field-spec item 4 / item 5 — Settings-managed, same CRUD
// shape as Company (companies.module.ts).
//
// Registration pivot, phase 1: a municipality is now also the unit the
// system rolls out by, and the unit fill-up allowances are counted in —
// FillUpRuleEngine counts a vehicle's/owner's history only within the
// municipality stamped on each FillUpTransaction (see there).
model Municipality {
  id                   String                  @id @default(cuid())
  name                 String                  @unique
  // Registration pivot, phase 3: short uppercase prefix for card numbers
  // issued in this municipality (سبها → SBH, so cards read SBH-7K2M9Q4X).
  // Optional until set; a card can't be issued in a municipality without one.
  code                 String?                 @unique
  isActive             Boolean                 @default(true) // No longer used — superseded by `status` in Phase 1; kept so migrations stay additive.
  // PREPARING: being set up — its stations are visible only on admin
  // screens (holders of stations:manage) and no fill-up can be recorded
  // at them. LIVE: in normal use. New rows start PREPARING; switching to
  // LIVE requires the municipality's security authority to exist first.
  status               MunicipalityStatus      @default(PREPARING)
  // Phase 6: no stages any more. These two were the awareness start and the card
  // deadline; nothing reads or writes them now (kept: migrations never drop).
  awarenessStartDate   DateTime?               @db.Date
  cardRequiredFromDate DateTime?               @db.Date
  // Phase 6: the activation switch. `status` says whether it is on; these say
  // since when and who switched it. It gates nothing - it only marks when the
  // municipality started working (reports start their range from it).
  activatedAt          DateTime?
  activatedById        String?
  settings             MunicipalitySetting[]
  // Exactly one per municipality (client-confirmed, OPEN_ITEMS.md #4) —
  // the authority overseeing every petrol station in it. Stations get
  // their authority from here, never picked per station.
  securityAuthority    SecurityAuthority?
  // Phase 5A: archived instead of deleted; history stays. An archived
  // municipality is hidden from daily screens and its stations and offices
  // take no new fill-ups or registrations.
  archivedAt           DateTime?
  archivedById         String?
  stations             Station[]
  registrationStations RegistrationStation[]
  fillUps              FillUpTransaction[]
  userScopes           UserMunicipalityScope[]
  createdAt            DateTime                @default(now())
}

// Fixed, not Settings-managed — code branches on these values (same
// reasoning as StationStatus below).
enum MunicipalityStatus {
  PREPARING // قيد الإعداد
  LIVE // مُفعَّلة
}

// Registration pivot, phase 2: a police-station registration desk
// (مكتب تسجيل) — the only place vehicles and owners are registered. Not a
// petrol Station: no fuel, no company, no fill-ups. Its security authority
// comes from its municipality (one per municipality), so there's no
// authority field here. Desks/printers arrive in Phase 3.
model RegistrationStation {
  id                 String                         @id @default(cuid())
  // Auto-generated, same pattern as Station.internalCode (REG-000001).
  internalCode       String                         @unique
  // The official code, if the police station has one — many won't.
  officialCode       String?
  name               String
  municipalityId     String
  municipality       Municipality                   @relation(fields: [municipalityId], references: [id])
  address            String
  latitude           Decimal?                       @db.Decimal(9, 6)
  longitude          Decimal?                       @db.Decimal(9, 6)
  contactPhone       String?
  workingHours       String? // free text, e.g. "السبت–الخميس 8:00–14:00"
  status             RegistrationStationStatus      @default(ACTIVE)
  statusNote         String?
  // Phase 5A: the area or neighbourhood (filter on the office list).
  locality           String?
  // Phase 5A: archived instead of deleted (see Station.archivedAt).
  archivedAt         DateTime?
  archivedById       String?
  userScopes         UserRegistrationStationScope[]
  vehiclesRegistered Vehicle[]
  desks              RegistrationDesk[]
  cardsIssued        VehicleCard[]
  cardPrints         CardPrint[]
  stockEntries       StockEntry[]
  duplicateCatches   DuplicateCatch[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
}

// Registration pivot, phase 3: a desk at a registration station, with the
// card printer attached to its computer. Phase 7: no longer used - desks and
// printers are gone from the app, and a card or a print is recorded against
// the office and the employee only. The table and its rows are kept.
model RegistrationDesk {
  id                    String              @id @default(cuid())
  registrationStationId String
  registrationStation   RegistrationStation @relation(fields: [registrationStationId], references: [id])
  name                  String
  printerModel          String?
  printerSerial         String?
  isActive              Boolean             @default(true)
  cardsIssued           VehicleCard[]
  cardPrints            CardPrint[]
  stockEntries          StockEntry[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([registrationStationId, name])
}

// Registration pivot, phase 3: the printed vehicle card (plan §6). The QR
// on the card carries cardNumber ONLY — never the vehicle's internalCode,
// plate, a URL or a name. A lost/replaced/cancelled card stops working
// without touching the vehicle's identity.
model VehicleCard {
  id                    String                 @id @default(cuid())
  // Random, not sequential: <municipality code>-<8 chars from an alphabet
  // with no look-alikes (no 0/O, no 1/I/L)>, e.g. SBH-7K2M9Q4X.
  cardNumber            String                 @unique
  vehicleId             String
  vehicle               Vehicle                @relation(fields: [vehicleId], references: [id])
  registrationStationId String
  registrationStation   RegistrationStation    @relation(fields: [registrationStationId], references: [id])
  deskId                String? // Phase 7: desks are gone; set on cards issued before
  desk                  RegistrationDesk?      @relation(fields: [deskId], references: [id])
  issuedById            String
  issuedBy              User                   @relation("VehicleCardIssuedBy", fields: [issuedById], references: [id])
  issuedAt              DateTime               @default(now())
  reason                VehicleCardIssueReason
  reasonNote            String?
  status                VehicleCardStatus      @default(ACTIVE)
  // Equals vehicleId while ACTIVE, NULL otherwise. The unique index on it
  // is what enforces "only one active card per vehicle" in the database
  // (Postgres allows any number of NULLs in a unique column) — a partial
  // unique index can't be expressed in the Prisma schema.
  activeForVehicleId    String?                @unique
  replacedAt            DateTime?
  cancelledAt           DateTime?
  cancelledById         String?
  cancelledBy           User?                  @relation("VehicleCardCancelledBy", fields: [cancelledById], references: [id])
  cancelReason          String?
  // Snapshot of exactly what was printed. A reprint regenerates the PDF from
  // these (so it's always identical and no PDF is stored), and "needs
  // reissue" is simply: printedPlate/printedVehicleLine no longer match
  // the vehicle's current plate/make/model/colour.
  printedPlate          String
  printedVehicleLine    String
  printedOfficeName     String
  printedIssueDate      String // YYYY-MM-DD, Africa/Tripoli
  printedStationCode    String
  // Phase 6: the single face also prints these. Null on a card issued before
  // Phase 6 (the face then reads the vehicle's current values).
  printedMakeModel      String?
  printedColor          String?
  printedYear           String?
  printedFuel           String?
  printedChassis        String?
  printedBooklet        String?
  createdAt             DateTime               @default(now())

  @@index([vehicleId, issuedAt])
  @@index([registrationStationId, issuedAt]) // office monitoring: cards issued per office per day
  @@index([issuedById, issuedAt]) // per-employee activity
}

enum VehicleCardIssueReason {
  FIRST_ISSUE // أول بطاقة
  LOST // بدل فاقد
  DAMAGED // بدل تالف
  FAILED_PRINT // إعادة طباعة بعد فشل الطباعة
  DETAILS_CHANGED // تغيّرت البيانات المطبوعة
}

enum VehicleCardStatus {
  ACTIVE
  REPLACED
  CANCELLED
}

// Fixed, not Settings-managed — registration is refused unless ACTIVE.
enum RegistrationStationStatus {
  ACTIVE // تعمل
  TEMPORARILY_CLOSED // مغلقة مؤقتًا
  CLOSED // مغلقة
}

// station-card-field-spec item 5 — the client's ownership/haulage route
// (خط الإعداد), e.g. "خط سبها" — optional on a station, Settings-managed
// like Municipality/Company.
model Route {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  stations  Station[]
  createdAt DateTime  @default(now())
}

// Fixed, not Settings-managed — unlike Company/Municipality/Route (pure
// labels, nothing in the code branches on which one a station has), the
// rule engine/reporting/filtering logic checks against these specific
// values by name. A freely-editable Settings list would let someone
// rename or delete ACTIVE and quietly break every place that checks for
// it. See station-card-field-spec's own "why status and ownership-type
// aren't Settings-managed" section.
enum StationStatus {
  ACTIVE
  SUSPENDED_LEGAL // موقوفة قضائيًا
  SUSPENDED_COMMITTEE // موقوفة (لجنة)
  SUSPENDED_OWNER // معلّقة - خاصة
  NOT_YET_SUPPLIED // لم تُزوَّد بعد
  UNVERIFIED // غير مؤكد — from the handwritten list, needs manual review
}

// Fuel availability is TIME-VARYING per the client — never a fixed column on Station.
model StationFuelAvailability {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id])
  fuelType    FuelType
  isAvailable Boolean  @default(true)
  updatedBy   String? // userId
  updatedAt   DateTime @updatedAt

  @@unique([stationId, fuelType])
}

enum FuelType {
  PETROL_95
  DIESEL
  KEROSENE // currently unused per client, but the enum stays open for the future
}

// The security authority (الجهة الأمنية) overseeing one municipality's
// petrol stations — client-confirmed (docs/OPEN_ITEMS.md #4, answered):
// every municipality has exactly one, e.g. مديرية أمن سبها for سبها.
model SecurityAuthority {
  id             String        @id @default(cuid())
  name           String        @unique // e.g. "مديرية أمن سبها"
  // @unique enforces "one authority per municipality". Nullable only so
  // the migration that introduced it stays additive for any pre-existing
  // row; the API requires it on create.
  municipalityId String?       @unique
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  // Legacy per-station link (Station.securityAuthorityId) — no longer
  // written; see the note on that column.
  stations       Station[]
}

// ── RBAC ──────────────────────────────────────────────────────────────

model Role {
  id                        String           @id @default(cuid())
  name                      String           @unique // "station_employee", "station_supervisor", "directorate_admin", "system_admin"
  description               String?
  // Explicit, admin-managed "sees every station" flag. Never inferred from
  // an empty UserStationScope list — a scoped role with zero assigned
  // stations must see NOTHING, not everything. Only directorate-wide roles
  // (directorate_admin, system_admin) get this set to true.
  unrestrictedStationAccess Boolean          @default(false)
  // Registration pivot, phase 2: which side of the two-building split this
  // role belongs to. A user may never hold a PETROL_STATION role and a
  // REGISTRATION role at once (UsersService enforces it) — the person who
  // creates a vehicle's identity must never be the one recording its fuel.
  // Null = neither side (admin roles, which sit above both). Data, set from
  // rbac-catalog.ts's ROLE_KINDS by the seed/bootstrap sync — code checks
  // this column, never a role name (CLAUDE.md rule 2).
  kind                      RoleKind?
  // Phase 5A: holders of this role are confined to the municipalities listed
  // in UserMunicipalityScope - they reach every station and registration
  // office inside those municipalities and nothing outside. Data set from
  // rbac-catalog.ts's MUNICIPALITY_SCOPED_ROLES (never a role-name check in
  // code). false = scope comes only from the explicit station/office rows.
  municipalityScoped        Boolean          @default(false)
  permissions               RolePermission[]
  users                     UserRole[]
}

enum RoleKind {
  PETROL_STATION
  REGISTRATION
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // "fillups:create", "fillups:approve_exception", "reports:view_all_stations"
  description String?
  roles       RolePermission[]
  users       UserPermission[]
}

// Round 12: the client wants a right that is NOT tied to a role — "given to
// certain users they pick, it could be given to certain employees and not
// for other employees" (specifically fillups:record_exception, but built
// generically since the same need will recur). RbacService unions this with
// role-derived permissions rather than replacing them — a direct grant is
// additive on top of whatever the user's roles already provide, never a
// narrower override.
model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  grantedById  String
  grantedBy    User       @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id])
  grantedAt    DateTime   @default(now())

  @@id([userId, permissionId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id                           String                         @id @default(cuid())
  username                     String                         @unique
  passwordHash                 String
  fullName                     String
  phone                        String?
  isActive                     Boolean                        @default(true)
  mustChangePassword           Boolean                        @default(false)
  failedLoginAttempts          Int                            @default(0)
  lockedUntil                  DateTime?
  // Registration pivot, phase 4b: set on every successful login
  // (AuthService.validateCredentials). Null = never logged in. Shown on the
  // users list; the phase 4c monitoring reports use it too.
  lastLoginAt                  DateTime?
  // Phase 5A: "delete" means archive. An archived account cannot sign in
  // (isActive is cleared with it), disappears from daily lists and keeps its
  // history; the level that archived it can restore it.
  archivedAt                   DateTime?
  archivedById                 String?
  municipalityScope            UserMunicipalityScope[]
  roles                        UserRole[]
  directPermissions            UserPermission[]
  permissionsGranted           UserPermission[]               @relation("UserPermissionGrantedBy")
  registrationStationScope     UserRegistrationStationScope[] // same semantics as stationScope, for registration stations
  registeredVehicles           Vehicle[]                      @relation("VehicleRegisteredBy")
  cardsIssued                  VehicleCard[]                  @relation("VehicleCardIssuedBy")
  cardPrints                   CardPrint[]                    @relation("CardPrintedBy")
  stockEntriesCreated          StockEntry[]                   @relation("StockEntryCreatedBy")
  duplicateCatches             DuplicateCatch[]               @relation("DuplicateCaughtBy")
  cardsCancelled               VehicleCard[]                  @relation("VehicleCardCancelledBy")
  stationScope                 UserStationScope[] // the stations this user is confined to, UNLESS one of their roles has unrestrictedStationAccess: true — an empty list here means access to NO stations, never "all of them"
  refreshTokens                RefreshToken[]
  recordedFillUps              FillUpTransaction[]            @relation("RecordedBy")
  vehicleChangeRequestsMade    VehicleChangeRequest[]         @relation("VehicleChangeRequestedBy")
  vehicleChangeRequestsDecided VehicleChangeRequest[]         @relation("VehicleChangeDecidedBy")
  ownerChangeRequestsMade      OwnerChangeRequest[]           @relation("OwnerChangeRequestedBy")
  ownerChangeRequestsDecided   OwnerChangeRequest[]           @relation("OwnerChangeDecidedBy")
  standingExceptionsGranted    StandingException[]            @relation("StandingExceptionGrantedBy")
  standingExceptionsRevoked    StandingException[]            @relation("StandingExceptionRevokedBy")
  auditLogs                    AuditLog[]
  notifications                Notification[]
  fuelStockEntriesCreated      FuelStockEntry[]               @relation("FuelStockEntryCreatedBy")
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// Station-scoped access — a station employee is restricted to their station(s) at the QUERY level, not just the UI.
model UserStationScope {
  userId    String
  stationId String
  user      User    @relation(fields: [userId], references: [id])
  station   Station @relation(fields: [stationId], references: [id])

  @@id([userId, stationId])
}

// Registration pivot, phase 2: mirrors UserStationScope for registration
// stations. A registration employee/supervisor can only register at the
// stations listed here, UNLESS one of their roles has
// unrestrictedStationAccess (admins). Empty = no stations, never "all".
model UserRegistrationStationScope {
  userId                String
  registrationStationId String
  user                  User                @relation(fields: [userId], references: [id])
  registrationStation   RegistrationStation @relation(fields: [registrationStationId], references: [id])

  @@id([userId, registrationStationId])
}

// Phase 5A: mirrors UserStationScope for municipalities. A user holding a
// municipalityScoped role reaches every station and registration office in
// these municipalities (RbacService expands it) and nothing outside them.
model UserMunicipalityScope {
  userId         String
  municipalityId String
  user           User         @relation(fields: [userId], references: [id])
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  @@id([userId, municipalityId])
  @@index([municipalityId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String // never store the raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Tunable business rules — the whole point of §3 ───────────────────

model SystemSetting {
  key         String   @id // "fillup.max_per_week", "fillup.min_gap_days", "fillup.week_start_day", "fillup.max_per_week_per_driver", "fillup.min_gap_days_per_driver", "fillup.week_window_mode"
  value       String // stored as string, parsed by the consuming service
  description String?
  updatedAt   DateTime @updatedAt
}

// ── Drivers, Owners, Vehicles ────────────────────────────────────────

enum IdentityType {
  NATIONAL_ID
  ADMINISTRATIVE_ID // بديل معتمد لدى الطوارق وقبائل أخرى — equally valid per client confirmation
  // Round 11 item 1: a one-time fallback when the owner's real ID isn't
  // available on the spot — deliberately NOT equal standing to the other
  // two (see VehicleOwner.identityType's own comment and
  // FillUpsService.create's provisional-owner gate). No standard Libyan
  // driver's-license number format was found during research (only plate
  // formats and application-process pages turned up) — validated
  // permissively for now (DRIVERS_LICENSE_REGEX), see docs/OPEN_ITEMS.md.
  DRIVERS_LICENSE
  // Phase 5A: the provisional driver's-license path is removed from
  // registration, the API and the UI - the value stays in the enum only so
  // existing rows keep reading (migrations are additive). Nothing creates it.
  //
  // Phase 5A: an institution (bank, hospital, company). identityNumber is a
  // generated reference (INS-XXXXXXXX), never a person's number; the
  // responsible driver's national ID lives in
  // VehicleOwner.responsibleDriverNationalId.
  INSTITUTION
}

enum OwnerKind {
  INDIVIDUAL // individual
  INSTITUTION // institution
}

// Round 6: no longer required on a fill-up, and has no active create/edit UI
// (see docs/DESIGN_owner_based_fillups.md) — kept only so historical
// FillUpTransaction/DriverVehicle rows recorded before this change keep
// their driver attribution. Not written to going forward.
model Driver {
  id             String              @id @default(cuid())
  identityType   IdentityType
  identityNumber String // immutable together with identityType after creation, like User.username
  fullName       String
  phone          String? // TBD — see docs/OPEN_ITEMS.md #7. Nullable until confirmed.
  vehicles       DriverVehicle[]
  fillUps        FillUpTransaction[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([identityType, identityNumber])
}

// Round 11 item 1: owner identity is mandatory on a vehicle going forward
// (see Vehicle.ownerId), but a real national/administrative ID isn't
// always available on the spot when a vehicle is first registered — a
// DRIVERS_LICENSE identityType is a deliberately PROVISIONAL stand-in,
// good for exactly the vehicle's first fill-up (FillUpsService.create
// hard-blocks any later one, no exception route — the client's own
// framing was "only the first fill is available," not a flaggable rule).
// Provisional-ness is derived directly from identityType ===
// 'DRIVERS_LICENSE' rather than a separate status field — nothing else
// needs to vary independently of it yet; add a real status field instead
// if that ever changes.
model VehicleOwner {
  id                          String               @id @default(cuid())
  identityType                IdentityType
  identityNumber              String // immutable together with identityType after creation, like Driver.identityNumber/User.username — the ONLY sanctioned way to change it is via OwnerChangeRequest approval, same anti-fraud posture as VehicleChangeRequest for chassis/booklet
  fullName                    String
  phone                       String?
  address                     String?
  // Phase 5A. INSTITUTION owners: fullName is the institution's name (shown
  // as the owner's name everywhere); the responsible driver is who is held
  // accountable. The owner-level fill-up rules never lump an institution's
  // vehicles together - only the vehicle-level rules apply to them.
  ownerKind                   OwnerKind            @default(INDIVIDUAL)
  // The institution's name folded for duplicate checks (institutionNameKey);
  // unique so the same institution cannot be created twice. Null for
  // individuals.
  institutionNameKey          String?              @unique
  responsibleDriverNationalId String?
  responsibleDriverName       String?
  responsibleDriverPhone      String?
  vehicles                    Vehicle[]
  standingExceptions          StandingException[]
  changeRequests              OwnerChangeRequest[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@unique([identityType, identityNumber])
}

// Round 20: mirrors VehicleChangeRequest's anti-fraud gate, but for the
// owner's own identityType/identityNumber pair — the client asked that a
// typo'd owner NAME be directly editable (see UpdateOwnerDto), but a wrong
// identity NUMBER (the field fill-up rules and quotas key on) must go
// through the same request/approve flow as a vehicle's chassis/plate.
// identityType and identityNumber change TOGETHER (they're compound-unique
// on VehicleOwner) — unlike VehicleChangeRequest's single currentValue/
// requestedValue string, this needs both fields on each side explicitly.
// No "first-time null -> value set bypasses approval" case exists here
// (unlike vehicle chassis/booklet): identityType/identityNumber are
// required at owner creation, so every correction is a genuine
// displacement of an already-established identity and always goes through
// this table.
model OwnerChangeRequest {
  id                      String                     @id @default(cuid())
  ownerId                 String
  owner                   VehicleOwner               @relation(fields: [ownerId], references: [id])
  currentIdentityType     IdentityType
  currentIdentityNumber   String
  requestedIdentityType   IdentityType
  requestedIdentityNumber String
  reason                  String
  proofReference          String? // Phase 7: no longer asked for (the field is gone from every form); kept for the rows that have one
  status                  VehicleChangeRequestStatus @default(PENDING)
  requestedById           String
  requestedBy             User                       @relation("OwnerChangeRequestedBy", fields: [requestedById], references: [id])
  decidedById             String?
  decidedBy               User?                      @relation("OwnerChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt               DateTime?
  rejectionReason         String?

  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([requestedById, createdAt])
}

enum VehicleFuelType {
  PETROL // petrol
  DIESEL // diesel
}

enum VehicleUsageType {
  GOVERNMENT
  PRIVATE
  COMMERCIAL
}

// Round 12: "نوع المركبة" becomes a Settings-managed lookup, same shape as
// Municipality/Route/ExceptionType — admin/system_admin add categories
// (سيارة خاصة, نقل ثقيل, ...) without a deploy. Distinct from
// VehicleUsageType (GOVERNMENT/PRIVATE/COMMERCIAL, "نوع الاستخدام") — the
// client only asked to change this one, not the usage-type enum. Confirmed
// via the rule engine (no reference to either field anywhere in
// fillups/rule-engine) that converting this to a lookup table is safe.
model VehicleType {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
}

model Vehicle {
  id                                String                  @id @default(cuid())
  internalCode                      String                  @unique // fixed forever, even if the plate changes
  // After review (19 Oct 2026): NOT unique — two vehicles may share a plate
  // number; the chassis number (unique) tells them apart.
  currentPlate                      String
  // Registration pivot, phase 4a: currentPlate in its canonical form
  // `<city>-<serial>` from the one shared normalizePlate() (Western digits,
  // any separator read as one dash, no leading zeros — `8-1234567`,
  // `8 1234567`, `٨-١٢٣٤٥٦٧` and `08-1234567` are all `8-1234567`, while
  // `81-234567` stays a different plate). NULL when the stored plate can't
  // be split into a city code and a serial number (e.g. no separator) —
  // `plates:report` lists those. Every plate MATCH uses this column;
  // currentPlate stays exactly as entered. Deliberately NOT unique: older
  // data may already collide once normalized (reported, never merged) —
  // uniqueness is enforced by the application on new writes.
  normalizedPlate                   String?
  chassisNumber                     String?                 @unique
  // رقم كتيب السيارة — added for the anti-fraud chassis/booklet linkage
  // (docs/IMPLEMENTATION_PLAN.md phase note: chassis-booklet-linkage
  // proposal). Nullable: not every vehicle has one recorded yet.
  // After review (22 Oct 2026): unique EXCEPT «000000» (an unknown booklet
  // number, which may repeat) — a partial unique index Prisma cannot express,
  // made in migration 20261022090000_booklet_placeholder_repeats. Keep it
  // when generating a migration: never drop "Vehicle_registrationBooklet_unique".
  registrationBooklet               String?
  vehicleTypeId                     String?
  vehicleType                       VehicleType?            @relation(fields: [vehicleTypeId], references: [id])
  // Phase 5A: the make and the model, both free text typed exactly as written
  // in the vehicle's booklet. Before 5A the single `model` column held the
  // manufacturer picked from a list; the migration copies that into `make`
  // and clears `model`, so old rows read the same.
  make                              String?
  model                             String?
  // The fuel the vehicle itself runs on. A pump choice that does not match is
  // warned about (never blocked) and recorded on the fill-up.
  fuelType                          VehicleFuelType?
  // Ticked by the employee when the chassis number in the booklet is not the
  // usual 17 characters (6-20 allowed). Recorded and shown.
  chassisNonStandard                Boolean                 @default(false)
  color                             String?
  manufactureYear                   Int?
  usageType                         VehicleUsageType?
  // Round 11 item 1: the client confirmed owner information should be
  // mandatory going forward — enforced at CreateVehicleDto (application
  // level: ownerId is now required on create), NOT here. Left nullable in
  // the DATABASE deliberately: real existing vehicles have no owner at
  // all today (this column being nullable is exactly how that's possible
  // right now), and forcing it NOT NULL would need a migration/backfill
  // decision for those rows that hasn't been made — see docs/OPEN_ITEMS.md.
  // Don't silently pick a backfill strategy by flipping this to required.
  ownerId                           String?
  owner                             VehicleOwner?           @relation(fields: [ownerId], references: [id])
  // Registration pivot, phase 2: where and by whom this vehicle was
  // registered. Set once at creation, never updated. Null for vehicles
  // that predate registration stations. Phase 4's monitoring reports
  // count on these.
  registeredAtRegistrationStationId String?
  registeredAtRegistrationStation   RegistrationStation?    @relation(fields: [registeredAtRegistrationStationId], references: [id])
  registeredById                    String?
  registeredBy                      User?                   @relation("VehicleRegisteredBy", fields: [registeredById], references: [id])
  plateHistory                      VehiclePlateHistory[]
  chassisHistory                    VehicleChassisHistory[]
  bookletHistory                    VehicleBookletHistory[]
  changeRequests                    VehicleChangeRequest[]
  drivers                           DriverVehicle[]
  fillUps                           FillUpTransaction[]
  standingExceptions                StandingException[]
  cards                             VehicleCard[]
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt

  @@index([normalizedPlate])
  @@index([currentPlate])
  @@index([registeredAtRegistrationStationId, createdAt]) // vehicles registered per office
  @@index([registeredById, createdAt])
}

// Plates change (sale, re-registration, damage) — never lose fill-up history
// when that happens. Rows are closed (validTo set), never deleted/overwritten.
model VehiclePlateHistory {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  plate     String
  validFrom DateTime  @default(now())
  validTo   DateTime?

  @@index([vehicleId])
}

// Same pattern as VehiclePlateHistory, for chassisNumber. Only ever written
// by VehiclesService.applyApprovedChange (via a VehicleChangeRequest
// approval) once a value already exists — a first-time null -> value set
// doesn't go through the request/approval flow at all, so it doesn't get a
// history row either (nothing to preserve yet).
model VehicleChassisHistory {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  chassisNumber String
  validFrom     DateTime  @default(now())
  validTo       DateTime?

  @@index([vehicleId])
}

// Same pattern, for registrationBooklet.
model VehicleBookletHistory {
  id                  String    @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id])
  registrationBooklet String
  validFrom           DateTime  @default(now())
  validTo             DateTime?

  @@index([vehicleId])
}

enum VehicleChangeType {
  CHASSIS_CHANGE
  BOOKLET_CHANGE
  // Round 12: the client wants a vehicle-edit approval gate that follows
  // rule-eligibility impact, not an arbitrary field list — "things that
  // don't affect their fill up rule status" save immediately (model, color,
  // manufactureYear, vehicleTypeId — see VehiclesService.update), "things
  // that need approval are the ones that affect their fill up status" go
  // through this same request/approval flow instead. The rule engine keys
  // strictly off vehicleId + ownerId (see FillUpRuleEngine), so OWNER_CHANGE
  // is the clear case; USAGE_TYPE_CHANGE is included pre-emptively because a
  // per-usage-type liter cap SystemSetting already exists even though it
  // isn't wired into the engine yet (see SettingsAdminPage) — treating it as
  // rule-affecting now avoids a second migration once that wiring lands.
  OWNER_CHANGE
  // Deprecated (round 14): the client asked that "نوع المركبة" and "نوع
  // الاستخدام" not both be collected — one is enough, and it should be the
  // Settings-managed one (VehicleType/vehicleTypeId). usageType stays in
  // the schema for historical rows already carrying a value, but is no
  // longer collected or editable anywhere in the UI — VEHICLE_TYPE_CHANGE
  // below is what replaces this for the one type field that remains.
  USAGE_TYPE_CHANGE
  // Round 14: the client wants EVERY field that could affect a vehicle's
  // fill-up rule status to require approval, requestable by ordinary
  // station employees (not just supervisor-tier) and approved by
  // supervisor/directorate-admin/system-admin — explicitly including the
  // plate number, previously changed directly with no approval at all via
  // POST /vehicles/:id/plate-change (still exists, but now restricted to
  // vehicles:approve_change — see VehiclesController). PLATE_CHANGE reuses
  // the existing VehiclePlateHistory table the same way CHASSIS_CHANGE/
  // BOOKLET_CHANGE reuse their own history tables. VEHICLE_TYPE_CHANGE is
  // the client-requested single "نوع المركبة" field's own change type.
  PLATE_CHANGE
  VEHICLE_TYPE_CHANGE
}

enum VehicleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Anti-fraud gate for displacing an ALREADY-SET chassisNumber/
// registrationBooklet — the requested value never takes effect on creation;
// only VehiclesService.decideChange(..., 'approve') writes it to Vehicle,
// inside the same transaction as the history row and this row's own
// status update. A first-time null -> value set bypasses this table
// entirely (see VehiclesService.setOrRequestChange) — there's no
// established identity to displace yet, so nothing to gate.
model VehicleChangeRequest {
  id              String                     @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle                    @relation(fields: [vehicleId], references: [id])
  changeType      VehicleChangeType
  currentValue    String // snapshot at request time, for audit context
  requestedValue  String
  reason          String
  proofReference  String? // Phase 7: no longer asked for (the field is gone from every form); kept for the rows that have one
  status          VehicleChangeRequestStatus @default(PENDING)
  requestedById   String
  requestedBy     User                       @relation("VehicleChangeRequestedBy", fields: [requestedById], references: [id])
  decidedById     String?
  decidedBy       User?                      @relation("VehicleChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  rejectionReason String? // mandatory (enforced at the DTO level) when status is set to REJECTED; unset otherwise

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([requestedById, createdAt])
}

model DriverVehicle {
  driverId  String
  vehicleId String
  isPrimary Boolean @default(false)
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([driverId, vehicleId])
}

// ── Fill-ups & Exceptions ────────────────────────────────────────────

model FillUpTransaction {
  id                  String               @id @default(cuid())
  // Phase 4a: null for a fill-up recorded against a plate that isn't
  // registered yet (grace / awareness stages). The database requires a
  // vehicle OR a typed plate (CHECK FillUpTransaction_has_subject). When the
  // vehicle registers, its earlier unregistered fill-ups get this link.
  vehicleId           String?
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  // The plate exactly as the employee typed it, and its normalized form
  // (the key the by-plate allowance counts use). Null for a card scan.
  typedPlate          String?
  normalizedPlate     String?
  // How this fill-up identified its vehicle — Phase 4b's reports and the
  // deadline-readiness numbers count on it.
  identifiedBy        FillUpIdentification
  // Written reason of a supervisor's emergency override (the card
  // requirement waived at the deadline). Null otherwise.
  overrideReason      String?
  // Phase 6: why the card could not be used, set with identifiedBy NO_CARD:
  // CARD_DAMAGED | CAMERA_NOT_WORKING | CARD_NOT_FOUND.
  noCardReason        String?
  // Phase 5A: the fuel poured does not match the vehicle's own fuel type. A
  // warning, never a block - recorded so supervisors can see mismatches in
  // reports. false for unregistered plates and vehicles with no fuel type.
  fuelMismatch        Boolean              @default(false)
  // Nullable since round 6: fill-ups no longer require driver identity (see
  // docs/DESIGN_owner_based_fillups.md) — rule evaluation and standing
  // exceptions are scoped to the vehicle's owner instead. Kept (not
  // dropped) so historical fill-ups recorded before this change keep their
  // driver attribution.
  driverId            String?
  driver              Driver?              @relation(fields: [driverId], references: [id])
  stationId           String
  station             Station              @relation(fields: [stationId], references: [id])
  // The municipality this fill-up happened in — stamped from the
  // station's municipality at creation and NEVER updated afterward. The
  // rule engine counts allowances per vehicle/owner per municipality
  // against THIS column, not a live lookup through the station: if an
  // admin later corrects a station's municipality, past fill-ups keep
  // the municipality they actually happened in. Nullable only because
  // pre-existing rows at stations with no municipality can't be
  // backfilled; FillUpsService refuses to create a fill-up without one.
  // Phase 5C: required, now that every row carries one.
  municipalityId      String
  municipality        Municipality         @relation(fields: [municipalityId], references: [id])
  fuelType            FuelType
  quantityLiters      Decimal
  occurredAt          DateTime             @default(now())
  recordedById        String
  recordedBy          User                 @relation("RecordedBy", fields: [recordedById], references: [id])
  isException         Boolean              @default(false)
  exception           Exception?
  // Set when a rule that would have blocked this fill-up was instead
  // auto-allowed by an active StandingException — distinct from the
  // one-time isException/Exception flow (which requires a fresh
  // submission + approval every time). Never set together with
  // isException: a fill-up is either flagged for one-time review or
  // silently covered by a standing grant, not both.
  standingExceptionId String?
  standingException   StandingException?   @relation(fields: [standingExceptionId], references: [id])
  // Which specific rule the standing exception covered for THIS fill-up —
  // a grant can cover several rules, but a given fill-up trips at most one
  // (first-failure-wins, same as the rejection path).
  coveredRule         String?
  // Client retry key for POST /fillups — a flaky station connection retrying
  // the same submission must resolve to the SAME row, never a duplicate.
  idempotencyKey      String               @unique
  createdAt           DateTime             @default(now())

  @@index([vehicleId, occurredAt]) // the rule engine's hottest query path
  // Per-vehicle-per-municipality history — FillUpsRepository's vehicle
  // lookups, and the per-vehicle leg of the owner lookups (which join
  // through Vehicle.ownerId).
  @@index([vehicleId, municipalityId, occurredAt])
  // Phase 4a: allowance history of an unregistered plate, per municipality.
  @@index([municipalityId, normalizedPlate, occurredAt])
  @@index([driverId, occurredAt])
  // A station's tank: what was dispensed of one fuel since a moment (after
  // review, 19 Oct 2026: «مراقبة المحطات» reads it for every station).
  @@index([stationId, fuelType, occurredAt])
  @@index([stationId, occurredAt])
  @@index([municipalityId, occurredAt, stationId]) // deadline readiness: per day, per station
}

enum FillUpIdentification {
  CARD_SCAN // scanned the vehicle's card
  TYPED_REGISTERED // typed plate of a registered vehicle
  TYPED_UNREGISTERED // typed plate, no registered vehicle (grace / awareness)
  EMERGENCY_OVERRIDE // supervisor waived the card requirement after the deadline (no longer written, Phase 6)
  NO_CARD // Phase 6: a registered vehicle found by search because its card could not be used; noCardReason says why
}

// Interim design, NOT from the original client questionnaire — flagged to
// the client for confirmation (see docs/OPEN_ITEMS.md). A supervisor/admin
// grants an ongoing exemption from one or more specific rule codes to a
// vehicle owner, a vehicle, or both, instead of the requester needing a
// fresh one-time Exception every single time. Fully audited (grant +
// revoke), visible on the owner/vehicle's own profile, never a blanket
// "exempt from everything" — `rules` lists exactly which RuleFailureReason
// codes (plus the new LITERS_PER_PERSON_CAP_REACHED) this grant covers.
// Round 6: re-scoped from driverId to ownerId — see
// docs/DESIGN_owner_based_fillups.md.
model StandingException {
  id        String        @id @default(cuid())
  ownerId   String?
  owner     VehicleOwner? @relation(fields: [ownerId], references: [id])
  vehicleId String?
  vehicle   Vehicle?      @relation(fields: [vehicleId], references: [id])
  rules     String[] // RuleFailureReason codes this grant covers

  reason      String
  grantedById String
  grantedBy   User      @relation("StandingExceptionGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime? // null = indefinite, active until revoked

  revokedById String?
  revokedBy   User?     @relation("StandingExceptionRevokedBy", fields: [revokedById], references: [id])
  revokedAt   DateTime?

  coveredFillUps FillUpTransaction[]

  @@index([ownerId])
  @@index([vehicleId])
}

// Lookup table, not an enum — the client already surfaced two new exception
// categories after the first questionnaire round. New categories must never
// require a code change.
model ExceptionType {
  id            String      @id @default(cuid())
  key           String      @unique // "medical_chronic", "transit_traveler", "government", "emergency"
  name          String
  requiresProof Boolean     @default(true) // Phase 7: unused - no exception asks for a proof reference any more; kept for old rows
  isActive      Boolean     @default(true)
  // Phase 6: the rule(s) this type may override (RuleFailureReason values); empty = any rule.
  overridableRules String[] @default([])
  // Phase 6: how many times it can be used at ONE station in one Tripoli day. Null = no limit.
  dailyLimitPerStation Int?
  // Phase 6: null = offered everywhere (managed by the super admin); set = this
  // municipality only (managed by its manager).
  municipalityId String?
  exceptions    Exception[]
}

model Exception {
  id                  String            @id @default(cuid())
  fillUpTransactionId String            @unique
  fillUpTransaction   FillUpTransaction @relation(fields: [fillUpTransactionId], references: [id])
  exceptionTypeId     String
  exceptionType       ExceptionType     @relation(fields: [exceptionTypeId], references: [id])
  reason              String
  // Nullable: set only on approval, not at request time — a requested
  // exception has no approver yet (see POST /fillups/:id/exceptions/approve).
  approvedById        String?
  proofReference      String? // Phase 7: no longer asked for; kept for the rows that have one
  validUntil          DateTime? // null = one-off; set = recurring exception with an expiry
  createdAt           DateTime          @default(now())

  // Diagnostic snapshot of what the rule engine WOULD have rejected this
  // fill-up for, captured server-side at submission time (the engine is
  // run in diagnostic-only mode — its result is never trusted from the
  // client) — so the approver sees why this was flagged instead of a bare
  // "submitted as exception" with no context. Null only for rows created
  // before this field existed.
  triggerReason String? // a RuleFailureReason value, e.g. "DRIVER_GAP_TOO_SHORT"
  triggerDetail Json? // { vehicleInternalCode, vehicleCurrentPlate, occurredAt } of the specific prior fill-up that triggered it
  // Phase 6: this use went past the type's daily limit at the station (flagged).
  overLimit Boolean @default(false)
}

// Phase 6: per-municipality override of an exception setting (the global value
// lives in SystemSetting). key: exceptions.strict_limit | exceptions.station_daily_threshold.
model MunicipalitySetting {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  key            String
  value          String
  updatedById    String?
  updatedAt      DateTime     @updatedAt

  @@unique([municipalityId, key])
}

// Phase 6: one row per flag raised for a station in a Tripoli day, so a flag
// notification goes out once per type per station per day, not once per use.
model ExceptionFlag {
  id              String   @id @default(cuid())
  stationId       String
  day             DateTime @db.Date
  kind            String // TYPE_OVER_LIMIT | STATION_THRESHOLD
  exceptionTypeId String   @default("")
  createdAt       DateTime @default(now())

  @@unique([stationId, day, kind, exceptionTypeId])
}

// ── Audit ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "APPROVE_EXCEPTION" ...
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  // The browser and system the request came from (after review, 15 Oct 2026).
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}

// ── Registration pivot, phase 4c: monitoring reports ─────────────────

// One row per blank plastic card consumed at a desk: every card or reprint
// PDF printed (kind CARD) and every test card printed for set-up or a ribbon
// change (kind TEST). This is what the card-stock reconciliation counts as
// "prints the system recorded". Before phase 4c only card prints existed, as
// PRINT_CARD audit rows; the migration copies those in (nothing invented) and
// test-card prints are recorded from phase 4c on.
enum CardPrintKind {
  CARD // a card or reprint PDF printed
  TEST // a test card printed (desk set-up, ribbon change)
}

model CardPrint {
  id                    String              @id @default(cuid())
  registrationStationId String
  registrationStation   RegistrationStation @relation(fields: [registrationStationId], references: [id])
  deskId                String? // Phase 7: desks are gone; set on prints made before
  desk                  RegistrationDesk?   @relation(fields: [deskId], references: [id])
  kind                  CardPrintKind
  cardId                String? // null for a test card
  printedById           String
  printedBy             User                @relation("CardPrintedBy", fields: [printedById], references: [id])
  printedAt             DateTime            @default(now())

  @@index([registrationStationId, printedAt])
  @@index([deskId, printedAt])
  @@index([printedById, printedAt])
}

// Physical stock of blank cards. INSERT-ONLY: a database trigger (see the
// phase 4c migration) refuses UPDATE and DELETE, and the API has no such
// endpoints. A mistake is fixed by a new CORRECTION entry linked to the one it
// corrects, with a reason.
enum StockEntryKind {
  RECEIVED // a delivery of blanks (quantity received)
  COUNT // a physical count of blanks remaining (quantity counted)
  CORRECTION // replaces the quantity of the earlier entry it points to
}

model StockEntry {
  id                    String              @id @default(cuid())
  registrationStationId String
  registrationStation   RegistrationStation @relation(fields: [registrationStationId], references: [id])
  deskId                String? // null = the whole office
  desk                  RegistrationDesk?   @relation(fields: [deskId], references: [id])
  kind                  StockEntryKind
  quantity              Int
  occurredAt            DateTime // when the delivery arrived / when the count was made
  correctsEntryId       String?
  corrects              StockEntry?         @relation("StockEntryCorrection", fields: [correctsEntryId], references: [id])
  corrections           StockEntry[]        @relation("StockEntryCorrection")
  reason                String? // required on a CORRECTION
  createdById           String
  createdBy             User                @relation("StockEntryCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())

  @@index([registrationStationId, occurredAt])
  @@index([correctsEntryId])
}

// A registration attempt refused because the plate, chassis number or
// registration booklet already belongs to a vehicle. Recorded from phase 4c on
// (nothing earlier was kept), so reports say "recorded since <date>".
model DuplicateCatch {
  id                    String              @id @default(cuid())
  registrationStationId String
  registrationStation   RegistrationStation @relation(fields: [registrationStationId], references: [id])
  userId                String
  user                  User                @relation("DuplicateCaughtBy", fields: [userId], references: [id])
  fields                String[] // PLATE | CHASSIS | BOOKLET
  occurredAt            DateTime            @default(now())

  @@index([registrationStationId, occurredAt])
  @@index([userId, occurredAt])
}

// ── Registration pivot, phase 5B: fuel storage and notifications ──────

// One tank (or group of tanks) of one fuel type at one station. The level is
// never stored: it is opening level + deliveries - liters dispensed since,
// computed by the server (see fuel-stock/stock-level.ts).
model StationFuelStorage {
  id                 String   @id @default(cuid())
  stationId          String
  station            Station  @relation(fields: [stationId], references: [id])
  fuelType           FuelType
  capacityLiters     Decimal
  openingLevelLiters Decimal
  // Fill-ups before this moment are not subtracted from the opening level.
  openedAt           DateTime @default(now())
  // Alert state, so a crossing alerts once: true while the level is below the
  // low-stock threshold (or below zero) and the alert for it has been sent.
  lowStockAlerted    Boolean  @default(false)
  negativeAlerted    Boolean  @default(false)
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([stationId, fuelType])
}

enum FuelStockEntryKind {
  DELIVERY // a truck delivery (liters delivered)
  CORRECTION // replaces the liters of the delivery it points to
  RESET // the supervisor set the level to zero (liters = the level it had)
}

// INSERT-ONLY (database trigger, as for card stock): a mistake is fixed by a
// linked CORRECTION entry with a reason.
model FuelStockEntry {
  id              String             @id @default(cuid())
  stationId       String
  station         Station            @relation(fields: [stationId], references: [id])
  fuelType        FuelType
  kind            FuelStockEntryKind
  liters          Decimal
  occurredAt      DateTime
  truckPlate      String?
  waybillNumber   String?
  driverName      String?
  correctsEntryId String?
  corrects        FuelStockEntry?    @relation("FuelStockEntryCorrection", fields: [correctsEntryId], references: [id])
  corrections     FuelStockEntry[]   @relation("FuelStockEntryCorrection")
  reason          String?
  createdById     String
  createdBy       User               @relation("FuelStockEntryCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())

  @@index([stationId, fuelType, occurredAt])
  @@index([correctsEntryId])
}

// In-app notification, one row per recipient, kept 90 days.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // stable code, e.g. LOW_STOCK
  title      String
  body       String
  link       String? // in-app path of the thing it is about
  entityType String?
  entityId   String?
  // Same event, same user, once: a second row with this key is not written.
  dedupeKey  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}
