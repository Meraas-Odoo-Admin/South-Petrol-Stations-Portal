// M1 scope: Auth, RBAC, Users, Companies, Stations.
// M2 scope: Drivers, VehicleOwners, Vehicles.
// M3 scope: FillUpTransaction, ExceptionType, Exception.
// See docs/IMPLEMENTATION_PLAN.md §4 for the full schema this will grow into.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Companies & Stations ─────────────────────────────────────────────

model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  stations  Station[]
  createdAt DateTime  @default(now())
}

model Station {
  id                  String                    @id @default(cuid())
  internalCode        String                    @unique // the ONLY globally unique station identifier
  stationNumber       String // as reported by the company — NOT globally unique
  name                String
  companyId           String
  company             Company                   @relation(fields: [companyId], references: [id])
  municipality        String?
  status              StationStatus             @default(ACTIVE)
  securityAuthorityId String? // TBD — see docs/OPEN_ITEMS.md #4. Nullable until scope question is answered.
  securityAuthority   SecurityAuthority?        @relation(fields: [securityAuthorityId], references: [id])
  fuelAvailability    StationFuelAvailability[]
  userScopes          UserStationScope[]
  fillUps             FillUpTransaction[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([companyId, stationNumber]) // the composite key that encodes the lesson learned
}

enum StationStatus {
  ACTIVE
  SUSPENDED_LEGAL // موقوفة قضائيًا
  SUSPENDED_COMMITTEE // موقوفة (لجنة)
  SUSPENDED_OWNER // معلّقة - خاصة
  NOT_YET_SUPPLIED // لم تُزوَّد بعد
  UNVERIFIED // غير مؤكد — from the handwritten list, needs manual review
}

// Fuel availability is TIME-VARYING per the client — never a fixed column on Station.
model StationFuelAvailability {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id])
  fuelType    FuelType
  isAvailable Boolean  @default(true)
  updatedBy   String? // userId
  updatedAt   DateTime @updatedAt

  @@unique([stationId, fuelType])
}

enum FuelType {
  PETROL_95
  DIESEL
  KEROSENE // currently unused per client, but the enum stays open for the future
}

// Placeholder for the لجنة إعادة تنظيم المدن scope question — left unseeded until
// docs/OPEN_ITEMS.md #4 is answered.
model SecurityAuthority {
  id       String    @id @default(cuid())
  name     String    @unique // "مديرية أمن سبها", "الحرس البلدي", "الجمارك", ...
  stations Station[]
}

// ── RBAC ──────────────────────────────────────────────────────────────

model Role {
  id                        String           @id @default(cuid())
  name                      String           @unique // "station_employee", "station_supervisor", "directorate_admin", "system_admin"
  description               String?
  // Explicit, admin-managed "sees every station" flag. Never inferred from
  // an empty UserStationScope list — a scoped role with zero assigned
  // stations must see NOTHING, not everything. Only directorate-wide roles
  // (directorate_admin, system_admin) get this set to true.
  unrestrictedStationAccess Boolean          @default(false)
  permissions               RolePermission[]
  users                     UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // "fillups:create", "fillups:approve_exception", "reports:view_all_stations"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id                           String                 @id @default(cuid())
  username                     String                 @unique
  passwordHash                 String
  fullName                     String
  phone                        String?
  isActive                     Boolean                @default(true)
  mustChangePassword           Boolean                @default(false)
  failedLoginAttempts          Int                    @default(0)
  lockedUntil                  DateTime?
  roles                        UserRole[]
  stationScope                 UserStationScope[] // the stations this user is confined to, UNLESS one of their roles has unrestrictedStationAccess: true — an empty list here means access to NO stations, never "all of them"
  refreshTokens                RefreshToken[]
  recordedFillUps              FillUpTransaction[]    @relation("RecordedBy")
  vehicleChangeRequestsMade    VehicleChangeRequest[] @relation("VehicleChangeRequestedBy")
  vehicleChangeRequestsDecided VehicleChangeRequest[] @relation("VehicleChangeDecidedBy")
  standingExceptionsGranted    StandingException[]    @relation("StandingExceptionGrantedBy")
  standingExceptionsRevoked    StandingException[]    @relation("StandingExceptionRevokedBy")
  auditLogs                    AuditLog[]
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// Station-scoped access — a station employee is restricted to their station(s) at the QUERY level, not just the UI.
model UserStationScope {
  userId    String
  stationId String
  user      User    @relation(fields: [userId], references: [id])
  station   Station @relation(fields: [stationId], references: [id])

  @@id([userId, stationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String // never store the raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Tunable business rules — the whole point of §3 ───────────────────

model SystemSetting {
  key         String   @id // "fillup.max_per_week", "fillup.min_gap_days", "fillup.week_start_day", "fillup.max_per_week_per_driver", "fillup.min_gap_days_per_driver", "fillup.week_window_mode"
  value       String // stored as string, parsed by the consuming service
  description String?
  updatedAt   DateTime @updatedAt
}

// ── Drivers, Owners, Vehicles ────────────────────────────────────────

enum IdentityType {
  NATIONAL_ID
  ADMINISTRATIVE_ID // بديل معتمد لدى الطوارق وقبائل أخرى — equally valid per client confirmation
}

// Round 6: no longer required on a fill-up, and has no active create/edit UI
// (see docs/DESIGN_owner_based_fillups.md) — kept only so historical
// FillUpTransaction/DriverVehicle rows recorded before this change keep
// their driver attribution. Not written to going forward.
model Driver {
  id             String              @id @default(cuid())
  identityType   IdentityType
  identityNumber String // immutable together with identityType after creation, like User.username
  fullName       String
  phone          String? // TBD — see docs/OPEN_ITEMS.md #7. Nullable until confirmed.
  vehicles       DriverVehicle[]
  fillUps        FillUpTransaction[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([identityType, identityNumber])
}

model VehicleOwner {
  id                 String               @id @default(cuid())
  identityType       IdentityType
  identityNumber     String // immutable together with identityType after creation, like Driver.identityNumber/User.username
  fullName           String
  phone              String?
  address            String?
  vehicles           Vehicle[]
  standingExceptions StandingException[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([identityType, identityNumber])
}

enum VehicleUsageType {
  GOVERNMENT
  PRIVATE
  COMMERCIAL
}

model Vehicle {
  id                  String                  @id @default(cuid())
  internalCode        String                  @unique // fixed forever, even if the plate changes
  currentPlate        String                  @unique
  chassisNumber       String?                 @unique
  // رقم كتيب السيارة — added for the anti-fraud chassis/booklet linkage
  // (docs/IMPLEMENTATION_PLAN.md phase note: chassis-booklet-linkage
  // proposal). Nullable: not every vehicle has one recorded yet.
  registrationBooklet String?                 @unique
  vehicleType         String?
  model               String?
  color               String?
  manufactureYear     Int?
  usageType           VehicleUsageType?
  ownerId             String?
  owner               VehicleOwner?           @relation(fields: [ownerId], references: [id])
  plateHistory        VehiclePlateHistory[]
  chassisHistory      VehicleChassisHistory[]
  bookletHistory      VehicleBookletHistory[]
  changeRequests      VehicleChangeRequest[]
  drivers             DriverVehicle[]
  fillUps             FillUpTransaction[]
  standingExceptions  StandingException[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

// Plates change (sale, re-registration, damage) — never lose fill-up history
// when that happens. Rows are closed (validTo set), never deleted/overwritten.
model VehiclePlateHistory {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  plate     String
  validFrom DateTime  @default(now())
  validTo   DateTime?

  @@index([vehicleId])
}

// Same pattern as VehiclePlateHistory, for chassisNumber. Only ever written
// by VehiclesService.applyApprovedChange (via a VehicleChangeRequest
// approval) once a value already exists — a first-time null -> value set
// doesn't go through the request/approval flow at all, so it doesn't get a
// history row either (nothing to preserve yet).
model VehicleChassisHistory {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  chassisNumber String
  validFrom     DateTime  @default(now())
  validTo       DateTime?

  @@index([vehicleId])
}

// Same pattern, for registrationBooklet.
model VehicleBookletHistory {
  id                  String    @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id])
  registrationBooklet String
  validFrom           DateTime  @default(now())
  validTo             DateTime?

  @@index([vehicleId])
}

enum VehicleChangeType {
  CHASSIS_CHANGE
  BOOKLET_CHANGE
}

enum VehicleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Anti-fraud gate for displacing an ALREADY-SET chassisNumber/
// registrationBooklet — the requested value never takes effect on creation;
// only VehiclesService.decideChange(..., 'approve') writes it to Vehicle,
// inside the same transaction as the history row and this row's own
// status update. A first-time null -> value set bypasses this table
// entirely (see VehiclesService.setOrRequestChange) — there's no
// established identity to displace yet, so nothing to gate.
model VehicleChangeRequest {
  id              String                     @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle                    @relation(fields: [vehicleId], references: [id])
  changeType      VehicleChangeType
  currentValue    String // snapshot at request time, for audit context
  requestedValue  String
  reason          String
  proofReference  String // mandatory for both change types — not the fill-up ExceptionType's optional-per-category toggle
  status          VehicleChangeRequestStatus @default(PENDING)
  requestedById   String
  requestedBy     User                       @relation("VehicleChangeRequestedBy", fields: [requestedById], references: [id])
  decidedById     String?
  decidedBy       User?                      @relation("VehicleChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  rejectionReason String? // mandatory (enforced at the DTO level) when status is set to REJECTED; unset otherwise

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model DriverVehicle {
  driverId  String
  vehicleId String
  isPrimary Boolean @default(false)
  driver    Driver  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([driverId, vehicleId])
}

// ── Fill-ups & Exceptions ────────────────────────────────────────────

model FillUpTransaction {
  id                  String             @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id])
  // Nullable since round 6: fill-ups no longer require driver identity (see
  // docs/DESIGN_owner_based_fillups.md) — rule evaluation and standing
  // exceptions are scoped to the vehicle's owner instead. Kept (not
  // dropped) so historical fill-ups recorded before this change keep their
  // driver attribution.
  driverId            String?
  driver              Driver?            @relation(fields: [driverId], references: [id])
  stationId           String
  station             Station            @relation(fields: [stationId], references: [id])
  fuelType            FuelType
  quantityLiters      Decimal
  occurredAt          DateTime           @default(now())
  recordedById        String
  recordedBy          User               @relation("RecordedBy", fields: [recordedById], references: [id])
  isException         Boolean            @default(false)
  exception           Exception?
  // Set when a rule that would have blocked this fill-up was instead
  // auto-allowed by an active StandingException — distinct from the
  // one-time isException/Exception flow (which requires a fresh
  // submission + approval every time). Never set together with
  // isException: a fill-up is either flagged for one-time review or
  // silently covered by a standing grant, not both.
  standingExceptionId String?
  standingException   StandingException? @relation(fields: [standingExceptionId], references: [id])
  // Which specific rule the standing exception covered for THIS fill-up —
  // a grant can cover several rules, but a given fill-up trips at most one
  // (first-failure-wins, same as the rejection path).
  coveredRule         String?
  // Client retry key for POST /fillups — a flaky station connection retrying
  // the same submission must resolve to the SAME row, never a duplicate.
  idempotencyKey      String             @unique
  createdAt           DateTime           @default(now())

  @@index([vehicleId, occurredAt]) // the rule engine's hottest query path
  @@index([driverId, occurredAt])
  @@index([stationId, occurredAt])
}

// Interim design, NOT from the original client questionnaire — flagged to
// the client for confirmation (see docs/OPEN_ITEMS.md). A supervisor/admin
// grants an ongoing exemption from one or more specific rule codes to a
// vehicle owner, a vehicle, or both, instead of the requester needing a
// fresh one-time Exception every single time. Fully audited (grant +
// revoke), visible on the owner/vehicle's own profile, never a blanket
// "exempt from everything" — `rules` lists exactly which RuleFailureReason
// codes (plus the new LITERS_PER_PERSON_CAP_REACHED) this grant covers.
// Round 6: re-scoped from driverId to ownerId — see
// docs/DESIGN_owner_based_fillups.md.
model StandingException {
  id        String        @id @default(cuid())
  ownerId   String?
  owner     VehicleOwner? @relation(fields: [ownerId], references: [id])
  vehicleId String?
  vehicle   Vehicle?      @relation(fields: [vehicleId], references: [id])
  rules     String[] // RuleFailureReason codes this grant covers

  reason      String
  grantedById String
  grantedBy   User      @relation("StandingExceptionGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime? // null = indefinite, active until revoked

  revokedById String?
  revokedBy   User?     @relation("StandingExceptionRevokedBy", fields: [revokedById], references: [id])
  revokedAt   DateTime?

  coveredFillUps FillUpTransaction[]

  @@index([ownerId])
  @@index([vehicleId])
}

// Lookup table, not an enum — the client already surfaced two new exception
// categories after the first questionnaire round. New categories must never
// require a code change.
model ExceptionType {
  id            String      @id @default(cuid())
  key           String      @unique // "medical_chronic", "transit_traveler", "government", "emergency"
  name          String
  requiresProof Boolean     @default(true)
  isActive      Boolean     @default(true)
  exceptions    Exception[]
}

model Exception {
  id                  String            @id @default(cuid())
  fillUpTransactionId String            @unique
  fillUpTransaction   FillUpTransaction @relation(fields: [fillUpTransactionId], references: [id])
  exceptionTypeId     String
  exceptionType       ExceptionType     @relation(fields: [exceptionTypeId], references: [id])
  reason              String
  // Nullable: set only on approval, not at request time — a requested
  // exception has no approver yet (see POST /fillups/:id/exceptions/approve).
  approvedById        String?
  proofReference      String?
  validUntil          DateTime? // null = one-off; set = recurring exception with an expiry
  createdAt           DateTime          @default(now())

  // Diagnostic snapshot of what the rule engine WOULD have rejected this
  // fill-up for, captured server-side at submission time (the engine is
  // run in diagnostic-only mode — its result is never trusted from the
  // client) — so the approver sees why this was flagged instead of a bare
  // "submitted as exception" with no context. Null only for rows created
  // before this field existed.
  triggerReason String? // a RuleFailureReason value, e.g. "DRIVER_GAP_TOO_SHORT"
  triggerDetail Json? // { vehicleInternalCode, vehicleCurrentPlate, occurredAt } of the specific prior fill-up that triggered it
}

// ── Audit ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "APPROVE_EXCEPTION" ...
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
