# Copy to .env and fill in for local development.
# apps/api reads these directly; see docker-compose.yml in infra/ for matching local Postgres values.

NODE_ENV=development
PORT=3000

# Prisma datasource — must match infra/docker-compose.yml for local dev.
# Port 5433, not 5432: avoids colliding with any Postgres already running
# locally on the default port.
DATABASE_URL="postgresql://fuel_tracking:fuel_tracking@localhost:5433/fuel_tracking?schema=public"

# Comma-separated, no wildcard. The web app's dev origin by default.
CORS_ORIGINS="http://localhost:5173"

# JWT access token secret — generate a real random value, never commit one.
# Refresh tokens are opaque random values (stored hashed in RefreshToken),
# not JWTs, so they need no secret of their own.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
