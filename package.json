{
  "name": "fuel-tracking-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "refresh": "node scripts/refresh.mjs",
    "dev": "pnpm refresh && pnpm --parallel --filter ./apps/* run dev",
    "dev:phone": "node scripts/refresh.mjs && node scripts/dev-phone.mjs",
    "reset:test-users": "pnpm --filter @fuel-tracking/api run dev:reset-test-users",
    "build:packages": "pnpm --filter @fuel-tracking/shared-types run build",
    "build": "pnpm --recursive run build",
    "lint": "pnpm run build:packages && pnpm --recursive run lint",
    "typecheck": "pnpm run build:packages && pnpm --recursive run typecheck",
    "test": "pnpm run build:packages && pnpm --recursive run test && pnpm run test:scripts",
    "prepare": "husky",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
